# Backend environment (used when running directly on the host, e.g. `npm run dev`)
# In Docker these values come from the root docker-compose.yml instead.

NODE_ENV=development
PORT=3000

# Use `localhost` when the postgres container's port is published on the host.
DATABASE_URL=postgresql://pm_user:pm_password@localhost:5432/project_management

JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=1d

CORS_ORIGIN=*
LOG_LEVEL=debug
