# ============================================================
# Project Management Application - environment configuration
# Copy to .env and adjust before running `docker compose up -d`
# ============================================================

NODE_ENV=development

# --- Ports exposed on the host ---
FRONTEND_PORT=8080
BACKEND_PORT=3000
POSTGRES_PORT=5432

# --- PostgreSQL ---
POSTGRES_USER=pm_user
POSTGRES_PASSWORD=pm_password
POSTGRES_DB=project_management

# DATABASE_URL used by the backend container (hostname = service name `postgres`)
DATABASE_URL=postgresql://pm_user:pm_password@postgres:5432/project_management

# For running the backend / tests directly on the host, use:
# DATABASE_URL=postgresql://pm_user:pm_password@localhost:5432/project_management

# Tests always use a SEPARATE database so they never touch the real one.
# It is created automatically as <POSTGRES_DB>_test (project_management_test)
# when running `npm test` in backend/. Override if needed:
# TEST_DB_NAME=project_management_test
# TEST_DATABASE_URL=postgresql://pm_user:pm_password@localhost:5432/project_management_test

# --- Authentication ---
# IMPORTANT: change this in any real deployment
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=1d

# --- Misc ---
CORS_ORIGIN=*
LOG_LEVEL=info
